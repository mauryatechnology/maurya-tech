# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://maurya-tech.com

# ---- Vercel Blob Storage ----
BLOB_READ_WRITE_TOKEN=

# ---- SMTP Mail ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# ---- Auth ----
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---- First-run admin bootstrap (only used when the user collection is empty) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PIN=

# ---- Cloudflare Turnstile (Bot Protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Cron & Automation ----
CRON_SECRET=
