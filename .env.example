# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://maurya-tech.com

# ---- Vercel Blob Storage ----
BLOB_READ_WRITE_TOKEN=

# ---- SMTP Mail ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# ---- Auth ----
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---- First-run admin bootstrap (only used when the user collection is empty) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PIN=

# ---- Cloudflare Turnstile (Bot Protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Cron & Automation ----
CRON_SECRET=

# ---- Display ads (leave ADS_ENABLED=false until AdSense approves the site) ----
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# Optional per-placement overrides
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_MID=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# Fixed-size units (opt-in; nothing renders without them)
# Desktop side rails — 160x600 from 1536px, 300x600 from 1800px wide
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
# Mobile 320x50 anchor (after scroll, dismissible)
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=
# Extra ads.txt lines for other networks (Ezoic, Mediavine…), separated by \n
ADS_TXT_EXTRA=

# ---- Search engines ----
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Random 32+ character hex string; served at /indexnow-key.txt
INDEXNOW_KEY=
